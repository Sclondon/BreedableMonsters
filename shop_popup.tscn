[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://shop_popup.gd" id="1_shop"]

[node name="ShopPopup" type="PanelContainer"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -330.0
offset_top = -220.0
offset_right = 330.0
offset_bottom = 220.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_shop")

[node name="Rows" type="VBoxContainer" parent="."]
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Rows"]
theme_override_font_sizes/font_size = 18
text = "SPECIMEN CATALOGUE  ::  3 CULTURED POLYMONS"

[node name="Offers" type="HBoxContainer" parent="Rows"]
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="Buttons" type="HBoxContainer" parent="Rows"]
theme_override_constants/separation = 8
alignment = 2

[node name="Reroll" type="Button" parent="Rows/Buttons"]
text = "RE-CULTURE"

[node name="Close" type="Button" parent="Rows/Buttons"]
text = "CLOSE"
